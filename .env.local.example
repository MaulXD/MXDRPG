# ════════════════════════════════════════════════════════════════
# MXDRPG — Hospedagem local pelo mestre
# Copie este arquivo para .env.local e preencha os campos marcados
# ════════════════════════════════════════════════════════════════

# ── Ngrok (OBRIGATÓRIO) ──────────────────────────────────────────
# Crie conta gratuita em https://ngrok.com → Dashboard → Your Authtoken
NGROK_AUTHTOKEN=cole_seu_token_aqui

# ── Segredo de sessão (OBRIGATÓRIO) ─────────────────────────────
# Gere um aleatório: rode scripts/local/setup.bat (Windows) ou setup.sh (Linux/Mac)
# Ou gere manualmente: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=gere_um_segredo_de_32_chars_aqui

# ── Banco de dados ───────────────────────────────────────────────
# Senha do MariaDB local (padrão já funciona, pode deixar assim)
DB_PASSWORD=mxdrpg_local
DB_ROOT_PASSWORD=mxdrpg_root

# ── URL da aplicação ─────────────────────────────────────────────
# Deixe como localhost para acesso local.
# Mude para a URL do ngrok SE quiser OAuth Google/Discord.
AUTH_URL=http://localhost:3000

# ── OAuth Google (OPCIONAL) ──────────────────────────────────────
# Deixe em branco para desabilitar login com Google.
# Necessário configurar redirect URI no Google Console = AUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth Discord (OPCIONAL) ─────────────────────────────────────
# Deixe em branco para desabilitar login com Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
