# MXDRPG — homolog local. Copie para .env.homolog (gitignore) e rode npm run homolog:up
# Requer Docker Desktop (MariaDB em docker-compose.homolog.yml)
# Banco `eldarin` = schema do módulo Eldarin (RPG) no hub — nome técnico legado

DATABASE_URL=mysql://eldarin:eldarin_homolog@127.0.0.1:3306/eldarin

# Sessão local (login e-mail/senha e OAuth state)
SESSION_SECRET=homolog-local-change-me-min-32-chars

# Marca ambiente homolog — mesa-local abre sem convite; não usar em produção
NEXT_PUBLIC_HOMOLOG=1
HOMOLOG_LOCAL=1

# Opcional — OAuth só aparece na UI se os três estiverem definidos
# AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
