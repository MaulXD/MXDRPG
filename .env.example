# Produção (Contabo): copie para secrets do servidor / .env do container.
# Rebuild Docker após alterar NEXT_PUBLIC_* — ver DEPLOY.md

# MariaDB (Contabo / local). Omit = salas/usuários em memória + JSON.
# ELDARIN_DISABLE_DB=1
# DATABASE_URL=mysql://user:password@host:3306/eldarin?ssl=true
# Contabo / cert autoassinado: MARIADB_SSL_REJECT_UNAUTHORIZED=0
# ou na URL: ?sslaccept=accept_invalid_certs

# Sessão legada (e-mail/senha local)
# SESSION_SECRET=change-me-in-production-min-32-chars

# AUTH_URL=https://www.mxdrpg.com.br
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
