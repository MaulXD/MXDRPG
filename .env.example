# Produção (Contabo): copie para secrets do servidor / .env do container.
# Rebuild Docker após alterar NEXT_PUBLIC_* — ver DEPLOY.md

# Postgres (Neon). Omit = salas/usuários em memória + JSON.
# ELDARIN_DISABLE_DB=1
# Neon dashboard → Connect → "Pooled connection" (host com -pooler) → copiar string.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Sessão legada (e-mail/senha local)
# SESSION_SECRET=change-me-in-production-min-32-chars

# AUTH_URL=https://www.mxdrpg.com.br
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...

# Clerk (opcional — omit = OAuth manual + e-mail/senha)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/entrar/apelido
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/entrar/apelido
#
# Eldarin NÃO usa Clerk Organizations — no Dashboard Clerk:
# Configure → Organizations → desabilitar (mesas/amigos ficam no Postgres).
# Mantenha o webhook user.created / user.updated para sync de avatar OAuth.
